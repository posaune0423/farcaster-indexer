{
  "name": "@posaune0423/farcaster-indexer",
  "version": "1.0.0",
  "author": "Greg Skriloff",
  "license": "ISC",
  "imports": {
    "@farcaster/hub-nodejs": "npm:@farcaster/hub-nodejs@0.11.0",
    "bullmq": "npm:bullmq@5.7.6",
    "cli-progress": "npm:cli-progress@3.12.0",
    "dotenv": "npm:dotenv@16.4.4",
    "drizzle-kit": "npm:drizzle-kit@^0.31.0",
    "ioredis": "npm:ioredis@5.4.1",
    "pg": "npm:pg@8.11.3",
    "pino": "npm:pino@8.19.0",
    "pino-pretty": "npm:pino-pretty@10.3.1",
    "drizzle-orm": "npm:drizzle-orm@0.30.10",
    "viem": "npm:viem@^2.27.0"
  },
  "tasks": {
    "build": "deno check ./src/index.ts",
    "start": "deno run --allow-env --allow-net --allow-read ./src/index.ts",
    "dev": "deno run --watch --allow-env --allow-net --allow-read ./src/index.ts",
    "backfill": "deno run --allow-env --allow-net --allow-read ./src/index.ts --backfill",
    "kysely:migrate": "deno run --allow-env --allow-net --allow-read ./src/db/migrator.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom"],
    "strict": true
  },
  "fmt": {
    "files": {
      "include": ["src/"],
      "exclude": ["dist/"]
    }
  }
}
